{
  "$schema":"https://json-schema.org/draft/2020-12/schema","type":"object",
  "required":["organization_id","hold_id","title","reason","legal_authority","status","revision","created_by","created_at","released_by","released_at","release_reason","scopes"],
  "properties":{
    "organization_id":{"type":"string"},"hold_id":{"type":"string"},
    "title":{"type":"string"},"reason":{"type":"string"},"legal_authority":{"type":"string"},
    "status":{"type":"string","enum":["active","released"]},
    "revision":{"type":"string","pattern":"^[1-9][0-9]*$"},
    "created_by":{"type":"string"},"created_at":{"type":"string","format":"date-time"},
    "released_by":{"type":["string","null"]},
    "released_at":{"type":["string","null"],"format":"date-time"},
    "release_reason":{"type":["string","null"]},
    "scopes":{"type":"array","maxItems":1000,"items":{"$ref":"#/$defs/HoldScope"}}
  },"additionalProperties":false,
  "$defs":{"HoldScope":{"type":"object","required":["scope_kind","scope_id","subject","created_at"],"properties":{
    "scope_kind":{"type":"string"},"scope_id":{"type":"string"},
    "subject":{"type":["string","null"]},"created_at":{"type":"string","format":"date-time"}
  },"additionalProperties":false}}
}
